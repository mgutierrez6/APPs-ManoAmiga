# Copiá este archivo como ".env" (en esta misma carpeta). El .env NO se sube a Git.

# --- URL de la API ---
# En desarrollo NO hace falta: la app arma sola la URL con la IP de la compu que corre "npx expo start"
# (la que aparece debajo del QR) + este puerto, que tiene que ser el FRONT_PORT del .env del servidor.
EXPO_PUBLIC_API_PORT=8090
# Solo para forzar una URL fija (por ejemplo, el servidor en AWS). Si está definida, gana sobre lo de arriba.
# EXPO_PUBLIC_API_URL=https://TU_DOMINIO/api/v1

# --- Notificaciones push y APK (EAS) ---
# Se obtiene corriendo "npx eas-cli init" en esta carpeta (con la sesión de Expo iniciada).
# Sin esto la app funciona igual, pero no registra el celular para recibir notificaciones.
EAS_PROJECT_ID=

# --- Mapa en el APK de Android ---
# Expo Go no la necesita. Para el APK: clave de "Maps SDK for Android" en Google Cloud.
GOOGLE_MAPS_API_KEY=
